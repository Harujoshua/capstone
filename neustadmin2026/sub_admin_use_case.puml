@startuml
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam shadowing false

actor "Sub Admin" as SubAdmin

rectangle "NEUST Gatepass Sub-Admin Module" {
    usecase "Login to Admin Portal" as UC01
    usecase "View Dashboard" as UC02
    usecase "Change Password / Email" as UC03
    usecase "Logout" as UC04

    usecase "Manage Class Schedules" as UC05
    usecase "Create Class Schedule" as UC05A
    usecase "Edit Schedule Details" as UC05B
    usecase "Delete Schedule" as UC05C

    usecase "Manage Students" as UC06
    usecase "Edit Student Information" as UC06A
    usecase "Block / Unblock Student" as UC06B
    usecase "Delete Student Record" as UC06C

    usecase "Manage Faculty" as UC07
    usecase "Add Faculty" as UC07A
    usecase "Edit Faculty Information" as UC07B
    usecase "Delete Faculty Record" as UC07C
    usecase "View Faculty Schedules" as UC07D
    usecase "Add Faculty Schedules" as UC07E
}

SubAdmin --> UC01
SubAdmin --> UC02
SubAdmin --> UC03
SubAdmin --> UC04

SubAdmin --> UC05
UC05 ..> UC05A : <<include>>
UC05 ..> UC05B : <<include>>
UC05 ..> UC05C : <<include>>

SubAdmin --> UC06
UC06 ..> UC06A : <<include>>
UC06 ..> UC06B : <<include>>
UC06 ..> UC06C : <<include>>

SubAdmin --> UC07
UC07 ..> UC07A : <<include>>
UC07 ..> UC07B : <<include>>
UC07 ..> UC07C : <<include>>
UC07 ..> UC07D : <<include>>
UC07 ..> UC07E : <<include>>

note right of SubAdmin
  Access is limited by the
  Super Administrator permission matrix.
  Global academic settings and admin management
  remain restricted to the super admin.
end note

@enduml
